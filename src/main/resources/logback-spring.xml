<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="API_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/api-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="SERVICE_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/service.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/service-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="ERROR_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/error-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="com.upgrade.store.api.controller" level="INFO" additivity="false">
        <appender-ref ref="API_LOG"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.upgrade.store.application.service.impl" level="DEBUG" additivity="false">
        <appender-ref ref="SERVICE_LOG"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="org.springframework.web" level="WARN" additivity="false">
        <appender-ref ref="ERROR_LOG"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.upgrade.store.infrastructure" level="INFO" additivity="false">
        <appender-ref ref="SERVICE_LOG"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <springProfile name="prod">
        <logger name="com.upgrade.store.api.controller" level="INFO"/>
        <logger name="com.upgrade.store.application.service.impl" level="INFO"/>
        <logger name="com.upgrade.store.infrastructure" level="INFO"/>
    </springProfile>

    <springProfile name="dev">
        <logger name="com.upgrade.store.api.controllers" level="DEBUG"/>
        <logger name="com.upgrade.store.application.service.impl" level="DEBUG"/>
        <logger name="com.upgrade.store.infrastructure" level="DEBUG"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERROR_LOG"/>
    </root>

</configuration>
